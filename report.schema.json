{
  "type": "object",
  "properties": {
    "project": {"type": "string"},
    "commit": {"type": "string"},
    "verdict": {"type": "string", "enum": ["CONTINUE", "MODIFY", "STOP", "INCONCLUSIVE"]},
    "technical_verdict": {"type": "string", "enum": ["CONTINUE", "MODIFY", "STOP", "INCONCLUSIVE"]},
    "viability_assessment": {
      "type": "object",
      "properties": {
        "project_type": {"type": "string", "enum": ["COMMERCIAL_PRODUCT", "INTERNAL_TOOL", "PERSONAL_TOOL", "MANDATED_DELIVERY", "UNKNOWN"]},
        "status": {"type": "string", "enum": ["PROVEN", "PLAUSIBLE", "UNPROVEN", "CHALLENGED", "KILL", "UNKNOWN"]},
        "problem": {"type": "string"},
        "beneficiary": {"type": "string"},
        "evidence_for_value": {"type": "array", "items": {"type": "object", "properties": {"claim": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^ev-[a-f0-9]{16}$"}}}, "required": ["claim", "evidence_ids"], "additionalProperties": false}},
        "evidence_against_value": {"type": "array", "items": {"type": "object", "properties": {"claim": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^ev-[a-f0-9]{16}$"}}}, "required": ["claim", "evidence_ids"], "additionalProperties": false}},
        "substitutes": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "assessment": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^ev-[a-f0-9]{16}$"}}}, "required": ["name", "assessment", "evidence_ids"], "additionalProperties": false}},
        "unique_value": {"type": "string"},
        "proof_gap": {"type": "string"},
        "strongest_stop_case": {"type": "string"},
        "strongest_continue_case": {"type": "string"},
        "would_start_today": {"type": "string", "enum": ["YES", "YES_BUT_SMALLER", "NOT_YET", "NO", "UNKNOWN"]},
        "next_validation": {"type": ["object", "null"], "properties": {"title": {"type": "string"}, "substeps": {"type": "array", "items": {"type": "string"}}}, "required": ["title", "substeps"], "additionalProperties": false},
        "override": {"type": ["object", "null"], "properties": {"previous_status": {"type": "string", "enum": ["PROVEN", "PLAUSIBLE", "UNPROVEN", "CHALLENGED", "KILL", "UNKNOWN"]}, "new_evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^ev-[a-f0-9]{16}$"}, "minItems": 1}, "rationale": {"type": "string"}}, "required": ["previous_status", "new_evidence_ids", "rationale"], "additionalProperties": false}
      },
      "required": ["project_type", "status", "problem", "beneficiary", "evidence_for_value", "evidence_against_value", "substitutes", "unique_value", "proof_gap", "strongest_stop_case", "strongest_continue_case", "would_start_today", "next_validation", "override"],
      "additionalProperties": false
    },
    "executive_summary": {"type": "string"},
    "runtime_status": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT RUN"]},
    "runtime_evidence": {
      "type": "array", "items": {
        "type": "object", "properties": {
          "check": {"type": "string"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT RUN"]},
          "command": {"type": "string"},
          "observation": {"type": "string"},
          "negative_control": {"type": "string"},
          "evidence_ids": {"type": ["array", "null"], "items": {"type": "string", "pattern": "^ev-[a-f0-9]{16}$"}, "minItems": 1}
        },
        "required": ["check", "status", "command", "observation", "negative_control", "evidence_ids"],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array", "items": {
        "type": "object", "properties": {
          "title": {"type": "string"},
          "severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
          "evidence_type": {"type": "string", "enum": ["OBSERVED", "INFERRED", "UNKNOWN"]},
          "evidence": {"type": "string"},
          "location": {"type": "string"},
          "recommended_fix": {"type": "string"},
          "id": {"type": "string", "pattern": "^F-[0-9]{3,}$"},
          "materiality": {"type": "string", "enum": ["BLOCKER", "MATERIAL", "DEFER", "INFORMATIONAL"]},
          "invariant": {"type": "string"},
          "consequence": {"type": "string"},
          "smallest_correction": {"type": "string"},
          "evidence_ids": {"type": ["array", "null"], "items": {"type": "string", "pattern": "^ev-[a-f0-9]{16}$"}, "minItems": 1}
        },
        "required": ["id", "title", "severity", "evidence_type", "evidence", "location", "recommended_fix", "materiality", "invariant", "consequence", "smallest_correction", "evidence_ids"],
        "additionalProperties": false
      }
    },
    "product_assessment": {
      "type": "object",
      "properties": {
        "purpose_fit": {"type": "string"},
        "strengths": {"type": "array", "items": {
          "type": "object",
          "properties": {
            "title": {"type": "string"}, "evidence": {"type": "string"}, "location": {"type": "string"},
            "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^ev-[a-f0-9]{16}$"}, "minItems": 1}
          },
          "required": ["title", "evidence", "location", "evidence_ids"], "additionalProperties": false
        }},
        "opportunities": {"type": "array", "items": {
          "type": "object",
          "properties": {
            "title": {"type": "string"}, "category": {"type": "string", "enum": ["product", "ux", "technical", "security", "reuse"]},
            "classification": {"type": "string", "enum": ["defect_remediation", "independent_enhancement", "validation_readiness", "unspecified"], "description": "Classify the opportunity's basis; legacy reports may omit this field and are rendered as unspecified."},
            "priority": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]}, "rationale": {"type": "string"},
            "impact": {"type": "string"}, "effort": {"type": "string"}, "acceptance_criteria": {"type": "string"},
            "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^ev-[a-f0-9]{16}$"}, "minItems": 1}
          },
          "required": ["title", "category", "classification", "priority", "rationale", "impact", "effort", "acceptance_criteria", "evidence_ids"], "additionalProperties": false
        }},
        "reuse_or_simplify": {"type": "array", "items": {
          "type": "object",
          "properties": {
            "title": {"type": "string"}, "rationale": {"type": "string"},
            "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^ev-[a-f0-9]{16}$"}, "minItems": 1}
          },
          "required": ["title", "rationale", "evidence_ids"], "additionalProperties": false
        }}
      },
      "required": ["purpose_fit", "strengths", "opportunities", "reuse_or_simplify"],
      "additionalProperties": false
    },
    "complexity_assessment": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["CLEAR", "CHALLENGE", "BLOCK", "UNKNOWN"]},
        "summary": {"type": "string"},
        "items": {"type": "array", "items": {
          "type": "object",
          "properties": {
            "trigger": {"type": "string"},
            "requirement": {"type": "string"},
            "why_now": {"type": "string"},
            "existing_alternative": {"type": "string"},
            "burden": {"type": "string"},
            "minimum_sufficient_path": {"type": "string"},
            "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^ev-[a-f0-9]{16}$"}, "minItems": 1}
          },
          "required": ["trigger", "requirement", "why_now", "existing_alternative", "burden", "minimum_sufficient_path", "evidence_ids"],
          "additionalProperties": false
        }}
      },
      "required": ["status", "summary", "items"],
      "additionalProperties": false
    },
    "decision_control": {
      "type": "object",
      "properties": {
        "gate_context": {
          "type": "object",
          "properties": {
            "current_gate": {"type": ["string", "null"]},
            "gate_question": {"type": ["string", "null"]},
            "pass_criteria": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["current_gate", "gate_question", "pass_criteria"],
          "additionalProperties": false
        },
        "evidence_ceiling": {"type": "string", "enum": ["SOURCE_REVIEW_STILL_USEFUL", "MOVE_TO_DETERMINISTIC_TEST", "MOVE_TO_CONTROLLED_RUNTIME", "MOVE_TO_LIVE_PROOF", "INSUFFICIENT_CONTEXT", "UNKNOWN"]},
        "audit_loop_risk": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"]},
        "blocking_finding_ids": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]{3,}$"}},
        "deferred_finding_ids": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]{3,}$"}},
        "primary_next_action": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "substeps": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["title", "substeps"],
          "additionalProperties": false
        }
      },
      "required": ["gate_context", "evidence_ceiling", "audit_loop_risk", "blocking_finding_ids", "deferred_finding_ids", "primary_next_action"],
      "additionalProperties": false
    },
    "reuse_assessment": {"type": "array", "items": {"type": "string"}},
    "commercial_risks": {"type": "array", "items": {"type": "string"}},
    "unverified": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "proposed_patch": {"type": ["string", "null"]}
  },
  "required": ["project", "commit", "verdict", "technical_verdict", "viability_assessment", "executive_summary", "runtime_status", "runtime_evidence", "findings", "product_assessment", "complexity_assessment", "decision_control", "reuse_assessment", "commercial_risks", "unverified", "next_actions", "proposed_patch"],
  "additionalProperties": false
}
