{
  "type": "object",
  "properties": {
    "action": {"type": "string", "enum": ["request", "final"]},
    "rationale": {"type": "string"},
    "requests": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "enum": ["source_search", "source_read", "runtime_evidence", "experiment", "experiment_spec", "correction_verification"], "description": "experiment_spec is a controller-validated bounded experiment declaration; correction_verification is rejected and never executed."},
          "query": {"type": ["string", "null"]},
          "paths": {"type": ["array", "null"], "items": {"type": "string"}, "maxItems": 10},
          "evidence_ids": {"type": ["array", "null"], "items": {"type": "string", "pattern": "^ev-[a-f0-9]{16}$"}, "minItems": 1},
          "experiment": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"]},
          "patch": {"type": ["string", "null"]},
          "continuation": {"type": ["integer", "null"], "minimum": 0},
          "ranges": {"type": ["array", "null"], "items": {"type": ["object", "null"], "properties": {"start": {"type": "integer", "minimum": 0}, "length": {"type": "integer", "minimum": 1}}, "required": ["start", "length"], "additionalProperties": false}, "maxItems": 10},
          "hypothesis": {"type": ["string", "null"]},
          "invariant": {"type": ["string", "null"]},
          "parameters": {"type": ["object", "null"]},
          "positive_control": {"type": ["string", "null"]},
          "negative_control": {"type": ["string", "null"]},
          "required_observations": {"type": ["array", "null"], "items": {"type": "string"}, "maxItems": 8},
          "falsification_conditions": {"type": ["array", "null"], "items": {"type": "string"}, "maxItems": 8}
        },
        "required": ["type", "query", "paths", "evidence_ids", "experiment", "reason", "patch", "continuation", "ranges", "hypothesis", "invariant", "parameters", "positive_control", "negative_control", "required_observations", "falsification_conditions"],
        "additionalProperties": false
      }
    }
  },
  "required": ["action", "rationale", "requests"],
  "additionalProperties": false
}
